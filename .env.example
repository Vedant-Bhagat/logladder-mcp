# Copy to .env and adjust. The default DSN matches infra/docker-compose.yml (user postgres, password loglad).
# Using another SereneDB? Put its DSN here, and set LOGLAD_PARQUET_DIR to where that server can read data/parsed/.
SERENEDB_DSN=postgresql://postgres:loglad@127.0.0.1:7890/
LOGLAD_PARQUET_DIR=/data/parsed
LOGLAD_CONSOLE_URL=http://127.0.0.1:7777
LOGLAD_SESSION_ID=
LOGLAD_QUERY_TIMEOUT_S=10
LOGLAD_LOG_LEVEL=INFO

# console (Ayoub)
LOGLAD_CONSOLE_PORT=7777
LOGLAD_SHELL=
LOGLAD_STARTUP_COMMAND=claude
LOGLAD_TERMINAL=on

# tests
LOGLAD_VALIDATE=0
