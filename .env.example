# Copy to .env and adjust. Vedant fills SERENEDB_DSN at V0 after checking `psql -h localhost -p 7890`.
SERENEDB_DSN=postgresql://localhost:7890/
LOGLAD_CONSOLE_URL=http://127.0.0.1:7777
LOGLAD_SESSION_ID=
LOGLAD_QUERY_TIMEOUT_S=10
LOGLAD_LOG_LEVEL=INFO

# console (Ayoub)
LOGLAD_CONSOLE_PORT=7777
LOGLAD_SHELL=
LOGLAD_STARTUP_COMMAND=claude
LOGLAD_TERMINAL=on

# tests
LOGLAD_VALIDATE=0
